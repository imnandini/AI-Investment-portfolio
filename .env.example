# Local development only. Copy to .env and replace the password before use.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://copilot:local-dev-only-change-me@localhost:5432/investment_copilot
DATABASE_ECHO=false
SECRET_KEY=local-development-key-change-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Used by docker-compose.yml for the local PostgreSQL service.
POSTGRES_DB=investment_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432
