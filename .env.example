# Local development only. Copy to .env and replace the password before use.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://copilot:local-dev-only-change-me@localhost:5432/investment_copilot
DATABASE_ECHO=false
SECRET_KEY=local-development-key-change-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set false to pause email verification while retaining password confirmation.
EMAIL_VERIFICATION_REQUIRED=true
# Required for registration and email verification. Use your provider's SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FINANCIAL_DATA_PROVIDER=none
FINANCIAL_DATA_TIMEOUT_SECONDS=5
# Personal-use daily closing prices, with no API key: set to yahoo to enable.
DAILY_PRICE_PROVIDER=none
INTERNAL_API_URL=http://127.0.0.1:8000
EMBEDDING_PROVIDER=hash
# Optional semantic model: install backend/requirements-models.txt and provision a 384-dimension model locally.
EMBEDDING_MODEL_PATH=
RERANKER_MODEL_PATH=
CHUNK_SIZE=1600
CHUNK_OVERLAP=200
REQUEST_LIMIT_PER_MINUTE=120
# Keep external tracing disabled for private document/portfolio data.
LANGSMITH_TRACING=false

# INDmoney: generate a Fernet key once; keep it private and stable across restarts.
# See docs/indmoney.md. For native Vite development use port 5173 below.
INDMONEY_TOKEN_KEY=
INDMONEY_REDIRECT_URI=http://127.0.0.1:8080/portfolios
# Optional pre-registered client; normally discovered/registered automatically.
INDMONEY_CLIENT_ID=
INDMONEY_CLIENT_SECRET=

# Used by docker-compose.yml for the local PostgreSQL service.
POSTGRES_DB=investment_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432
