# Local development only. Copy to .env and replace the password before use.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://copilot:local-dev-only-change-me@localhost:5432/investment_copilot
DATABASE_ECHO=false
SECRET_KEY=local-development-key-change-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FINANCIAL_DATA_PROVIDER=none
FINANCIAL_DATA_TIMEOUT_SECONDS=5
INTERNAL_API_URL=http://127.0.0.1:8000
EMBEDDING_PROVIDER=hash
# Optional semantic model: install backend/requirements-models.txt and provision a 384-dimension model locally.
EMBEDDING_MODEL_PATH=
RERANKER_MODEL_PATH=
CHUNK_SIZE=1600
CHUNK_OVERLAP=200
REQUEST_LIMIT_PER_MINUTE=120
# Keep external tracing disabled for private document/portfolio data.
LANGSMITH_TRACING=false

# Used by docker-compose.yml for the local PostgreSQL service.
POSTGRES_DB=investment_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432
